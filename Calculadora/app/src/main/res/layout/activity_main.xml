<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/rounded"
        android:backgroundTint="@color/backgroundCalculadora"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded"
            android:backgroundTint="@color/backgroundInput"
            android:clickable="false"
            android:enabled="false"
            android:focusable="false"
            android:gravity="end|center_vertical"
            android:inputType="number"
            android:padding="16dp"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:useDefaultMargins="true">

            <Button
                android:id="@+id/opMC"
                style="@style/OPMemoryButton"
                android:onClick="operacion"
                android:text="MC" />

            <Button
                android:id="@+id/opMR"
                style="@style/OPMemoryButton"
                android:onClick="operacion"
                android:text="MR" />

            <Button
                android:id="@+id/opMS"
                style="@style/OPMemoryButton"
                android:onClick="operacion"
                android:text="MS" />

            <Button
                android:id="@+id/opAC"
                style="@style/DangerButton"
                android:onClick="operacion"
                android:text="AC" />

            <Button
                android:id="@+id/opMPlus"
                style="@style/OPMemoryButton"
                android:onClick="operacion"
                android:text="M+" />

            <Button
                android:id="@+id/opMMinus"
                style="@style/OPMemoryButton"
                android:onClick="operacion"
                android:text="M-" />

            <Button
                android:id="@+id/opDel1"
                style="@style/DangerButton"
                android:onClick="operacion"
                android:text="C" />

            <Button
                android:id="@+id/opDiv"
                style="@style/OperationButton"
                android:onClick="operacion"
                android:text="/" />

            <Button
                android:id="@+id/num7"
                style="@style/NumberButton"
                android:onClick="numero"
                android:text="7" />

            <Button
                android:id="@+id/num8"
                style="@style/NumberButton"
                android:onClick="numero"
                android:text="8" />

            <Button
                android:id="@+id/num9"
                style="@style/NumberButton"
                android:onClick="numero"
                android:text="9" />

            <Button
                android:id="@+id/opMul"
                style="@style/OperationButton"
                android:onClick="operacion"
                android:text="X" />

            <Button
                android:id="@+id/num4"
                style="@style/NumberButton"
                android:onClick="numero"
                android:text="4" />

            <Button
                android:id="@+id/num5"
                style="@style/NumberButton"
                android:onClick="numero"
                android:text="5" />

            <Button
                android:id="@+id/num6"
                style="@style/NumberButton"
                android:onClick="numero"
                android:text="6" />

            <Button
                android:id="@+id/opRes"
                style="@style/OperationButton"
                android:onClick="operacion"
                android:text="-" />

            <Button
                android:id="@+id/num1"
                style="@style/NumberButton"
                android:onClick="numero"
                android:text="1" />

            <Button
                android:id="@+id/num2"
                style="@style/NumberButton"
                android:onClick="numero"
                android:text="2" />

            <Button
                android:id="@+id/num3"
                style="@style/NumberButton"
                android:onClick="numero"
                android:text="3" />

            <Button
                android:id="@+id/opSum"
                style="@style/OperationButton"
                android:onClick="operacion"
                android:text="+" />

            <Button
                android:id="@+id/num0"
                style="@style/NumberButton"
                android:layout_columnSpan="2"
                android:onClick="numero"
                android:text="0" />

            <Button
                android:id="@+id/opEq"
                style="@style/OperationButton"
                android:layout_columnSpan="2"
                android:onClick="operacion"
                android:text="=" />

        </GridLayout>
    </LinearLayout>
</LinearLayout>